{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MiningPortalDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AzureStorage": {
    "ConnectionString": "<azure-storage-connection-string>"
  },
  "Remita": {
    "BaseUrl": "https://login.remita.net/remita/",
    "MerchantId": "<merchant-id>",
    "ServiceTypeId": "<service-type-id>",
    "ApiKey": "<api-key>"
  }
}
